# ============================================================================
# Environment template — copy to `.env` (or `.env.local`) and fill in values.
# Real secrets must NEVER be committed; `.env*` files are gitignored.
#
# Switching between local / development / production requires NO code change:
# only this file (or the environment variables of the deployment) changes.
# ============================================================================

# local | development | production
APP_ENV=local

# HTTP port the server listens on: the testbed's port block +0
# (docs/testbed/ports.md).
PORT=40000

# --- Database -----------------------------------------------------------------
# Driver: `memory` (default; no external dependency — a testbed needs no
# database) or `postgres`.
DB_DRIVER=memory
# DATABASE_URL=postgres://app:app_local_password@localhost:5432/app

# Used by docker-compose to provision the Postgres container.
POSTGRES_USER=app
POSTGRES_PASSWORD=app_local_password
POSTGRES_DB=app
# Host port the container is published on. Projects run side by side locally
# (a service next to the member server) each need their own — change it here
# and in DATABASE_URL above together.
POSTGRES_PORT=5432

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed origins. Empty = same-origin only.
CORS_ORIGINS=http://localhost:40000

# --- Horizontal scaling --------------------------------------------------------
# Pub/sub driver used for cross-instance communication: `memory` | `redis`.
# `memory` only works within a single instance; switch to `redis` when running
# multiple instances behind a load balancer.
PUBSUB_DRIVER=memory
# REDIS_URL=redis://localhost:6379

# Role of this process: `web` (HTTP only) | `worker` (background jobs only) | `all`.
SERVER_ROLE=all

# --- Graceful shutdown ----------------------------------------------------------
# How long to keep reporting "not ready" before closing the listener, so load
# balancers stop routing traffic to this instance first.
SHUTDOWN_DRAIN_MS=3000

# --- Sign-in --------------------------------------------------------------------
# `none` (default when unset): no sign-in at all, /api/auth is not mounted.
# `oidc`: people sign in on the member server (hwahee/boilerplate-auth), which
# must be running. A testbed runs locally without sign-in; a shared server
# turns it on (docs/testbed/architecture.md). The values below are this
# service's entry in the member server's services/local.json; a new service
# adds its own entry there (its id is its subdomain) and copies the same
# values here.
AUTH_DRIVER=none
# OIDC_ISSUER=http://localhost:4444
# OIDC_CLIENT_ID=boilerplate
# OIDC_CLIENT_SECRET=local-only-boilerplate-client-secret
# Where browsers reach this service (the sign-in callback lives under it).
# PUBLIC_URL=http://localhost:40000
# Signs the session cookie. At least 32 characters; a long random one outside
# local, e.g. `openssl rand -base64 48`.
# SESSION_SECRET=local-only-session-secret-change-me-elsewhere

# --- Testbed (docs/testbed/architecture.md §7) ---------------------------------
# Boot defaults only; change things at runtime through the control API.
# Data and control planes bind here. 0.0.0.0 when the product is on another
# machine (the Docker image sets 0.0.0.0), together with TESTBED_PUBLIC_URL.
TESTBED_BIND_HOST=127.0.0.1
# The address put in the manifest and endpoint URLs. Default http://localhost:${PORT}.
# TESTBED_PUBLIC_URL=http://localhost:40000
TESTBED_EVENT_BUFFER=5000
# memory (gone on restart) | file (TESTBED_DATA_DIR/runs/*.jsonl)
TESTBED_RUN_STORE=memory
TESTBED_DATA_DIR=./data
TESTBED_RUN_RETENTION=50
TESTBED_MAX_PAYLOAD_BYTES=16384

# --- Sample core (docs/spec.md §7) ------------------------------------------------
SAMPLE_PORT=40001
SAMPLE_AUTO_START=true
SAMPLE_MAX_CONNECTIONS=100
SAMPLE_MAX_CHUNK_BYTES=65536
SAMPLE_IDLE_TIMEOUT_MS=0
